	"floor": ["trap_dps", "trap_wear", "trap_dps_player"], "decor": ["no_fusion", "eng_table", "drone_station", "drones_k", "builder_bay", "build_radius", "bot_speed", "build_time", "bot_hp", "bot_repair", "low", "power"], "foundation": ["height", "ramp", "on_water"],
