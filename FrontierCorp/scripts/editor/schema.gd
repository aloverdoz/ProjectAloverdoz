}


## Параметры здания, которые имеют смысл для его вида (+ те, что уже заданы).
static func params_for(beh: String, cur: Dictionary) -> Array:
	var want: Array = BEH_PARAMS.get(beh, []) + ["buildable", "pollution", "shelter_radius", "shield_radius", "radar_radius", "wild", "teleport"] + ([] if beh == "foundation" else ["any_ground"])
	want.append("defense")
	match str(cur.get("defense", "")):
		"barrier": want += ["barrier_radius", "barrier_hp", "barrier_regen", "barrier_delay", "barrier_color", "power"]
		"slow": want += ["slow_radius", "slow_k", "power"]
		"repair": want += ["repair_radius", "repair_rate", "power"]
	if beh in ["generator", "pole", "battery", "hq"] or "power" in want or float(cur.get("power", 0)) > 0.0:
		want += ["connectors", "wire_height"]
	var out := []
	for f in sub("bld_params"):
		if f[0] in want or cur.has(f[0]):
			out.append(f)
	return out


static func fields(t: String) -> Array:
	return TYPES.get(t, [])


static func sub(name: String) -> Array:
	return SUB.get(name, [])


