## Поля записи списка, которые зависят от самой записи (вид блока, вид действия).
static func sub_for(name: String, o: Dictionary) -> Array:
	match name:
		"block":
			var t := str(o.get("type", "produce"))
			var out: Array = [["type", "Блок", "enum:@BLOCKS", Blocks.TYPES.get(t, "")]]
			var ev := str(o.get("event", "every"))
			for f in Blocks.FIELDS.get(t, []):
				if t == "trigger" and ((f[0] == "every" and ev != "every") or (f[0] == "radius" and not ev in ["player_near", "enemy_near"])):
					continue
				var f2: Array = f.duplicate()
				if f2[2] == "enum:STATS":
					f2[2] = "enum:@STATS"
				out.append(f2)
			return out
		"mob_rule":
			var c := str(o.get("if", "always"))
			var a := str(o.get("then", "attack_player"))
			var out: Array = [["if", "Если", "enum:@MOB_IF", ""]]
			if c in ["sees_player", "player_far", "hp_below", "hp_above", "allies_near", "player_hp_below", "near_base", "chance", "timer"]:
				out.append(["n", "N", "float", MobRules.CONDS.get(c, "")])
			out.append(["not", "Наоборот (если НЕ)", "bool", ""])
			out.append(["then", "То", "enum:@MOB_DO", ""])
			if a in ["heal_self", "summon", "call_allies", "speed"]:
				out.append(["value", "Значение", "float", MobRules.ACTS.get(a, "")])
			if a == "summon":
				out.append(["enemy", "Монстр", "ref:enemies", ""])
			if a == "say":
				out.append(["text", "Текст", "str", ""])
			if a == "actions":
				out.append(["actions", "Действия", "list:cmd_action", "Как в командах консоли; $x, $z — клетка монстра"])
			out.append(["cooldown", "Не чаще, чем раз в, сек", "float", "0 — каждый раз"])
			out.append(["stop", "Дальше не проверять", "bool", "Вкл (по умолчанию) — после этого правила остальные не смотрит"])
			return out
		"cmd_action":
			var d := str(o.get("do", ""))
			if not Console.ACTIONS.has(d):
				return sub(name)
			var out: Array = [["do", "Действие", "enum:@ACTIONS", ""]]
			var desc: String = Console.ACTIONS[d]
			var i := desc.find("(")
			if i >= 0:
				for k in desc.substr(i + 1, desc.find(")") - i - 1).split(",", false):
					k = k.strip_edges()
					var kind := "str"
					match k:
						"item": kind = "ref:items"
						"enemy": kind = "ref:enemies"
					if d in ["sound"] and k == "key":
						kind = "ref:sounds"
					elif d in ["place"] and k == "key":
						kind = "ref:buildings"
					elif d in ["boost"] and k == "key":
						kind = "enum:@STATS"
					out.append([k, ACTION_ARGS.get(k, k), kind, "Можно $1, $2 (слова команды) или $x, $z (клетка здания)"])
			for k in o:
				if k != "do" and not out.any(func(f): return f[0] == k):
					out.append([k, ACTION_ARGS.get(k, k), "str", ""])
			return out
	return sub(name)


const ACTION_ARGS := {"item": "Предмет", "n": "Сколько", "text": "Текст", "flag": "Флаг", "key": "Что", "value": "Значение",
	"x": "Клетка x", "z": "Клетка z", "t": "Время", "enemy": "Монстр", "what": "Что", "v": "Число", "window": "Окно", "dist": "Радиус, клеток"}


## Таблицы для списков выбора: "enum:@BLOCKS" и т. п. → {значение: подпись}.
static func enum_table(name: String) -> Dictionary:
	match name:
		"STATS": return STATS
		"BLOCKS": return Blocks.TYPES
		"MOB_IF": return MobRules.CONDS
		"SHAPES": return {"box": "Куб", "cylinder": "Цилиндр", "cone": "Конус", "sphere": "Шар", "prism": "Призма", "wedge": "Клин",
			"torus": "Кольцо", "capsule": "Капсула", "gear": "Шестерня"}
		"PMATS": return {"paint": "Краска", "metal": "Металл", "dark": "Тёмный металл", "glass": "Стекло", "glow": "Светится",
			"concrete": "Бетон", "stone": "Камень", "wood": "Дерево", "cloth": "Ткань"}
		"MOB_DO": return MobRules.ACTS
		"EVENTS": return Blocks.EVENT_NAMES
		"ACTIONS":
			var out := {}
			for k in Console.ACTIONS:
				out[k] = "%s — %s" % [k, Console.ACTIONS[k].split(" (")[0]]
			return out
	return {}


## Подпись для значения из списка выбора.
static func enum_label(v: String) -> String:
	if STATS.has(v):
		return STATS[v]
	if ENUM_NAMES.has(v):
		return ENUM_NAMES[v]
	return UI_VALUES.get(v, v)
